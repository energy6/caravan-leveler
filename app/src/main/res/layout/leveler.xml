<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scene_background"
    tools:context=".LevelerFragment"
    tools:ignore="Overdraw">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/sceneView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/txtAxis"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnViewpane"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:contentDescription="@string/rotate_view"
        app:layout_constraintBottom_toBottomOf="@+id/sceneView"
        app:layout_constraintEnd_toEndOf="@+id/sceneView"
        app:borderWidth="0dp"
        app:maxImageSize="32dp"
        app:srcCompat="@mipmap/ic_viewpane" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCalibration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:contentDescription="@string/start_calibration"
        android:visibility="gone"
        app:borderWidth="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/sceneView"
        app:layout_constraintStart_toStartOf="@+id/sceneView"
        app:maxImageSize="32dp"
        app:srcCompat="@drawable/ic_calibrate"
        app:tint="?attr/colorOnSecondary" />


    <TextView
        android:id="@+id/txtAxis"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/colorPrimary"
        android:ems="10"
        android:padding="4dp"
        android:textAlignment="center"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/txtStabilizer"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtStabilizer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/colorPrimary"
        android:ems="10"
        android:padding="4dp"
        android:textAlignment="center"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/txtAxis" />

</androidx.constraintlayout.widget.ConstraintLayout>
